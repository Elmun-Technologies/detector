# =============================================================================
# Viral Video AI — PRODUCTION environment template
#
# Copy to `.env` and fill in. With ENVIRONMENT=production the API refuses to
# start until every section below is complete (fail-fast by design).
# docker compose reads this file for both app settings and service credentials.
# =============================================================================

# --- core (required) ---------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/DB      # compose: leave the host as `postgres`
REDIS_URL=redis://redis:6379/0
QUEUE_MODE=celery

# compose service credentials (interpolated into docker-compose.yml)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- identity / auth (required) ----------------------------------------------
JWT_SECRET=                       # long random string, e.g. `openssl rand -hex 32`
JWT_ISSUER=viral-video-ai
JWT_AUDIENCE=viral-dashboard
ENCRYPTION_KEY=                   # Fernet key: `python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"`
ADMIN_API_KEY=                    # optional: guards /v1/admin/summary

# --- object storage (required — private bucket) --------------------------------
STORAGE_BACKEND=s3
S3_BUCKET=viral-media             # private, no anonymous access (compose creates it)
S3_ENDPOINT=                      # MinIO: http://minio:9000 · AWS: leave empty
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_SERVER_SIDE_ENCRYPTION=AES256   # optional

# --- AI providers (required — no key, no fabricated output) ---------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
STT_PROVIDER=openai
STT_MODEL=whisper-1
VISION_PROVIDER=openai
OCR_PROVIDER=openai
AUDIO_PROVIDER=
LLM_PROVIDER=openai
RESEARCH_PROVIDER=
ALLOW_DEMO_PROVIDERS=false        # production hard-requirement

# --- Telegram (required for dashboard login + bot delivery) ----------------------
TELEGRAM_BOT_TOKEN=               # from @BotFather
TELEGRAM_WEBHOOK_SECRET=          # any long random string (you set it on the webhook)
TELEGRAM_WEBAPP_SECRET=           # any long random string (verify Mini App init data)

# --- Instagram / Meta (optional — account connection) ---------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# --- payments (optional — pick one provider, PAYMENT_PROVIDER must match) --------
PAYMENT_PROVIDER=none             # none | stripe | payme | click
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYME_KEY=
CLICK_SECRET_KEY=

# --- http -------------------------------------------------------------------------
CORS_ORIGINS=https://your-domain.uz
