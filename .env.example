# Core production mode (production fails fast if core settings are absent)
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/viral.db
REDIS_URL=redis://redis:6379/0
QUEUE_MODE=inline
JWT_SECRET=
ADMIN_API_KEY=
ENCRYPTION_KEY=
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=180
UPLOADS_DIR=./data/uploads
RATE_LIMIT_PER_MINUTE=60

# Telegram: required for polling/webhooks/WebApp identity
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_SECRET=

# S3 / MinIO: required when STORAGE_BACKEND=s3
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# OpenAI-compatible STT/LLM gateway
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
STT_PROVIDER=openai
VISION_PROVIDER=
OCR_PROVIDER=
AUDIO_PROVIDER=
RESEARCH_PROVIDER=

# Meta Graph / Instagram OAuth
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# Payment gateway: none | stripe | payme | click
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYME_KEY=
CLICK_SECRET_KEY=

# Frontend relative API path
VITE_API_URL=/api
