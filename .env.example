# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# API / uploads
ENVIRONMENT=development
MAX_UPLOAD_BYTES=524288000
MAX_DURATION_SECONDS=180
UPLOADS_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173

# Browser code uses a relative URL. Vite proxies /api to FastAPI in development;
# route /api to the API service in your reverse proxy for production.
VITE_API_URL=/api
