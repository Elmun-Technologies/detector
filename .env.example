# =============================================================================
# Viral Video AI — environment reference
#
# Values below are DEVELOPMENT defaults. Production fails fast (see
# Settings.validate_production) when the core database / queue / storage / auth
# settings are still development values.
# =============================================================================

# --- core --------------------------------------------------------------------
ENVIRONMENT=development                 # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=json                         # json (structured) | text (local reading)
DATABASE_URL=sqlite:///./data/viral.db  # production: postgresql+psycopg://user:pass@host:5432/db
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=                      # optional override of REDIS_URL
CELERY_RESULT_BACKEND=                  # optional override of REDIS_URL
QUEUE_MODE=inline                       # inline (dev/test only) | celery (production)

# --- identity / auth ----------------------------------------------------------
JWT_SECRET=
JWT_ISSUER=viral-video-ai
JWT_AUDIENCE=viral-dashboard
ADMIN_API_KEY=
ENCRYPTION_KEY=                         # Fernet key for Instagram token storage
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# --- object storage -----------------------------------------------------------
STORAGE_BACKEND=local                   # local (dev only) | s3 (production, MinIO or AWS)
UPLOADS_DIR=./data/uploads              # private root for the local backend
STORAGE_URL_TTL_SECONDS=900             # lifetime of presigned upload/download URLs
STORAGE_MAX_ATTEMPTS=3
STORAGE_RETRY_BACKOFF_SECONDS=0.5
ARTIFACT_RETENTION_HOURS=24             # derived frames/audio/thumbnails expiry
SOURCE_RETENTION_DAYS=30                # original upload retention
S3_BUCKET=
S3_ENDPOINT=                            # e.g. http://minio:9000 (leave empty for AWS)
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true                # required by MinIO
S3_SERVER_SIDE_ENCRYPTION=              # e.g. AES256 or aws:kms

# --- upload limits ------------------------------------------------------------
MAX_UPLOAD_BYTES=524288000              # 500 MB
MAX_DURATION_SECONDS=180

# --- media pipeline (FFmpeg/FFprobe must be installed in the worker image) -----
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FFPROBE_TIMEOUT_SECONDS=30
FFMPEG_TIMEOUT_SECONDS=300
FRAME_SAMPLE_INTERVAL_SECONDS=2.0
FRAME_SAMPLE_MAX=12
KEYFRAME_MAX=8
THUMBNAIL_CANDIDATES=3
SCENE_CHANGE_THRESHOLD=0.30
SILENCE_NOISE_DB=-35
SILENCE_MIN_SECONDS=0.4
AUDIO_SAMPLE_RATE=16000

# --- worker / queue -----------------------------------------------------------
TASK_MAX_RETRIES=3
TASK_RETRY_BACKOFF_SECONDS=10           # exponential: 10s, 20s, 40s ...
TASK_RETRY_BACKOFF_MAX_SECONDS=600
TASK_SOFT_TIME_LIMIT=900
TASK_TIME_LIMIT=1200
JOB_HEARTBEAT_TIMEOUT_SECONDS=600       # after this a job is treated as worker-lost

# --- AI providers -------------------------------------------------------------
# Unconfigured providers raise configuration errors; they never fabricate output.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai                     # report narrative (required in production)
STT_PROVIDER=openai                     # speech to text
STT_MODEL=whisper-1
VISION_PROVIDER=                        # empty = signal downgraded to insufficient_data
VISION_MODEL=gpt-4.1-mini
OCR_PROVIDER=
OCR_MODEL=gpt-4.1-mini
AUDIO_PROVIDER=
RESEARCH_PROVIDER=                      # external citations for external_source evidence
PROVIDER_TIMEOUT_SECONDS=90
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=1.0
LLM_INPUT_COST_PER_1K=0                 # cost ledger inputs (USD per 1k tokens)
LLM_OUTPUT_COST_PER_1K=0
STT_COST_PER_MINUTE=0
DEFAULT_LANGUAGE=uz
SUPPORTED_LANGUAGES=uz,ru,en,mixed
ALLOW_DEMO_PROVIDERS=true               # ALWAYS false/ignored in production

# --- evidence policy ----------------------------------------------------------
STALE_EVIDENCE_DAYS=180                 # citations older than this are flagged stale

# --- Telegram -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBAPP_SECRET=

# --- Meta Graph / Instagram OAuth ---------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# --- payments: none | stripe | payme | click ----------------------------------
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYME_KEY=
CLICK_SECRET_KEY=

# --- frontend -----------------------------------------------------------------
VITE_API_URL=/api
